# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL on RDS)
# DATABASE_URL="postgresql://user:password@your-rds-host:5432/hospital_crm"
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="https://crm.yourcompany.com"
# 企微/微信消息卡片外链（可选；不填则用 NEXTAUTH_URL，并自动避开 IP）
# PUBLIC_APP_URL="https://crm.yourcompany.com"
LLM_API_KEY=""
# 也可在管理员 → 系统配置 → AI 助手中配置（优先于环境变量）
LLM_API_BASE="https://api.moonshot.cn/v1"
LLM_MODEL="kimi-k2.5"

# 浏览器语音输入（硅基流动 SenseVoice，OpenAI 兼容 /audio/transcriptions）
# 也可在管理员 → 系统配置 → AI 助手中配置（优先于环境变量）
STT_API_KEY=""
STT_API_BASE="https://api.siliconflow.cn/v1"
STT_MODEL="FunAudioLLM/SenseVoiceSmall"

# 企业微信自建应用（H5 销售日志入口）
WECOM_CORP_ID=""
WECOM_AGENT_ID=""
WECOM_SECRET=""

# 定时任务密钥（日报 20/21 催交、22 点迟交锁定）
# curl -H "Authorization: Bearer $CRON_SECRET" "$NEXTAUTH_URL/api/cron/daily-report-reminders?slot=20"
CRON_SECRET=""

# 报销模块（本地默认开启；生产勿设或显式 false，侧栏/页面不暴露）
# ENABLE_EXPENSE_REIMBURSEMENT=true

# 高德地图（打卡定位：逆地理编码 + 地图展示）
# 也可在管理员 → 系统配置 → 打卡定位中配置（优先于环境变量）
AMAP_WEB_SERVICE_KEY=""
# JS API Key：浏览器地图展示，控制台开启「Web 端(JS API)」并配置域名白名单
NEXT_PUBLIC_AMAP_WEB_KEY=""
