# Copy to .env for local use. Never commit real secrets.
# See Agent Store: docs/kimi-membership-credentials.md

CURSOR_API_KEY=
CURSOR_USAGE_SESSION_TOKEN=

# --- Kimi Code / membership quota (PRIMARY) ---
# Preferred: Console API key starting with sk-kimi-
# Get from Kimi Code Console (NOT platform.kimi.com / Moonshot open platform).
KIMI_CODE_TOKEN=
# Aliases also accepted by the adapter:
# KIMI_API_KEY=
# KIMI_CODE_API_KEY=
# Or run `kimi login` so ~/.kimi/credentials/kimi-code.json exists (OAuth access_token).

# --- Kimi Open Platform balance (SECONDARY; separate product) ---
MOONSHOT_API_KEY=

# Optional overrides
# MOONSHOT_BASE_URL=https://api.moonshot.cn
# KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
