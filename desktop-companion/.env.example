# Copy to .env for local use (OPTIONAL fallback). Never commit real secrets.
# Preferred: paste credentials in the app Settings UI (system keychain / local vault).

# Spending session (primary) — WorkosCursorSessionToken or accessToken JWT
# When missing or fetch fails: deep-link Spending, never invent numbers.
CURSOR_USAGE_SESSION_TOKEN=

# Deferred / optional — Cloud Agents (default off in app; not required)
# CURSOR_API_KEY=

# --- Deferred / not in current Cursor-only build ---
# KIMI_AUTH_TOKEN=
# MOONSHOT_API_KEY=
