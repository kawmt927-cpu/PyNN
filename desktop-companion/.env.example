# Copy to .env for local use (OPTIONAL fallback). Never commit real secrets.
# Preferred: paste kimi-auth in the app Settings UI (system keychain / local vault).
# Checklist: Agent Store docs/kimi-membership-credentials.md

CURSOR_API_KEY=
CURSOR_USAGE_SESSION_TOKEN=

# --- Kimi MEMBER "用量进度" (PRIMARY) — NOT Code ---
# Preferred: in-app Settings →「Kimi 会员 Token」→ Save.
# Fallback only: paste browser/desktop Cookie value named "kimi-auth" (JWT Access Token).
# Do NOT use sk-kimi- Code Console keys here.
KIMI_AUTH_TOKEN=
# Aliases: KIMI_WEB_TOKEN=  KIMI_ACCESS_TOKEN=

# --- Kimi Open Platform balance (SECONDARY; pay-as-you-go) ---
MOONSHOT_API_KEY=

# Optional
# MOONSHOT_BASE_URL=https://api.moonshot.cn
