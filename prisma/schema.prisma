generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  SALES
  SALES_MANAGER
  PROJECT_ADMIN
  PROJECT_MANAGER
  PROJECT_STAFF
  ADMIN
}

enum StaffCategory {
  SALES
  IMPLEMENTATION
}

enum PersonnelType {
  PROJECT_MANAGER
  CONSULTANT
  IMPLEMENTER
  DEVELOPER
}

enum CustomerCategory {
  HOSPITAL
  COMPANY
  INDIVIDUAL
}

enum HospitalLevel {
  GRADE_3A
  GRADE_3B
  GRADE_3
  GRADE_2A
  GRADE_2B
  GRADE_2
  OTHER
}

enum FollowUpMethod {
  PHONE
  WECHAT
  FACE_VISIT
  ONLINE_MEETING
  OTHER
}

enum SigningType {
  DIRECT
  INDIRECT
}

enum ContractStatus {
  PENDING_APPROVAL
  REJECTED
  PENDING_SIGN
  SIGNED_PENDING_IMPL
  IMPLEMENTING
  ACCEPTED
  MAINTAINING
  TERMINATED
}

enum OpportunityStatus {
  NOT_SIGNED
  SIGNED
  ABANDONED
}

enum OpportunityAbandonReason {
  PRICE
  BUSINESS_RELATIONSHIP
  OPERATION_ERROR
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ProjectStatus {
  PENDING_START
  IMPLEMENTING
  ACCEPTED
  MAINTAINING
  CLOSED
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  PENDING_APPROVAL
  PENDING
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  BLOCKED
  REJECTED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum SalesCostType {
  PERSONAL_TRAVEL
  PRESALES
  BUSINESS
}

enum SalesTaskType {
  VISIT
  COMMUNICATE
  FOLLOW_UP
}

enum SalesDailyLogStatus {
  IN_PROGRESS
  PENDING_CONFIRM
  SUBMITTED
  RISK_SUBMITTED
}

enum SalesDailyLogRiskFlag {
  NONE
  RISK
}

enum SalesCheckInStatus {
  PENDING
  COMPLETED
}

enum SalesWeeklyAssignmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SalesPlanPeriod {
  YEAR
  MONTH
}

enum SalesPlanItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum PresalesAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CustomerClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WeComAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── User & Personnel ────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          UserRole  @default(SALES)
  wecomUserId   String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  personnelProfile   PersonnelProfile?
  ownedCustomers     Customer[]           @relation("CustomerOwner")
  followUps          FollowUp[]
  contracts          Contract[]           @relation("ContractOwner")
  salesTargets        SalesTarget[]
  salesMonthlyTargets SalesMonthlyTarget[]
  salesTasks         SalesTask[]
  salesDailyLogs     SalesDailyLog[]
  salesCostsIncurred SalesCost[]          @relation("SalesCostSalesUser")
  salesCostsRecorded SalesCost[]          @relation("SalesCostRecorder")
  projectMembers     ProjectMember[]
  assignedTasks      Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  managedProjects    Project[]            @relation("ProjectManager")
  presalesAssigned   PresalesAssignment[] @relation("PresalesStaff")
  presalesCreated    PresalesAssignment[] @relation("PresalesAssigner")
  presalesCostFor    SalesCost[]          @relation("PresalesCostUser")
  presalesSalesFor   PresalesAssignment[] @relation("PresalesSalesUser")
  projectCosts       ProjectCost[]
  customerClaimsRequested CustomerClaimRequest[] @relation("ClaimRequester")
  customerClaimsReviewed  CustomerClaimRequest[] @relation("ClaimReviewer")
  contractsAsOurRep       Contract[]             @relation("ContractOurRep")
  contractsSubmitted      Contract[]             @relation("ContractSubmitter")
  contractsApproved       Contract[]             @relation("ContractApprover")
  contractPaymentsRecorded ContractPaymentRecord[] @relation("ContractPaymentRecorder")
  ownedOpportunities      Opportunity[]          @relation("OpportunityOwner")
  opportunityStageLogs    OpportunityStageLog[]
  opportunityFollowUps    OpportunityFollowUp[]
  aiAgentConfigsUpdated   AiAgentConfig[]      @relation("AiAgentConfigUpdater")
  amapConfigsUpdated      AmapConfig[]         @relation("AmapConfigUpdater")
  salesCheckIns           SalesCheckIn[]       @relation("SalesCheckInUser")
  weeklyAssignmentsCreated SalesWeeklyAssignment[] @relation("WeeklyAssignmentCreator")
  weeklyAssignmentsAssigned SalesWeeklyAssignment[] @relation("WeeklyAssignmentAssignee")
  salesPlanBoards          SalesPlanBoard[]
  assistedCustomers        CustomerAssistant[]      @relation("CustomerAssistant")
  wecomAccessRequestsReviewed WeComAccessRequest[] @relation("WeComAccessReviewer")
  wecomAccessRequest         WeComAccessRequest?
}

model WeComAccessRequest {
  id          String            @id @default(cuid())
  wecomUserId String
  name        String
  email       String
  message     String?
  status      WeComAccessStatus @default(PENDING)
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  userId      String?           @unique
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  reviewer User? @relation("WeComAccessReviewer", fields: [reviewerId], references: [id])
  user     User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([wecomUserId])
}

model PersonnelProfile {
  id             String         @id @default(cuid())
  userId         String         @unique
  staffCategory  StaffCategory
  personnelType  PersonnelType?
  isPresales     Boolean        @default(false)
  dailyRate      Decimal?
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── CRM: Customer ───────────────────────────────────────

model Customer {
  id              String           @id @default(cuid())
  name            String
  category        CustomerCategory
  hospitalLevel   HospitalLevel?
  province        String?
  city            String?
  district        String?
  bedCount        Int?
  existingSystem  String?
  source          String?
  customerType    String?
  customerGrade   String?
  ownerId         String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner              User?              @relation("CustomerOwner", fields: [ownerId], references: [id])
  contacts           Contact[]
  followUps          FollowUp[]
  contractsAsSign    Contract[]         @relation("SignCustomer")
  contractsAsEndUser Contract[]         @relation("EndUserCustomer")
  projects           Project[]
  salesTasks         SalesTask[]
  salesCosts         SalesCost[]        @relation("BusinessExpenseCustomer")
  presalesAssignments PresalesAssignment[]

  relationsFrom CustomerRelation[] @relation("CustomerFrom")
  relationsTo   CustomerRelation[] @relation("CustomerTo")
  claimRequests CustomerClaimRequest[]
  opportunities Opportunity[]
  salesCheckIns SalesCheckIn[]
  tags          CustomerTag[]
  weeklyAssignments SalesWeeklyAssignment[]
  planItems         SalesPlanItem[]
  assistantOwners   CustomerAssistant[]
}

model CustomerAssistant {
  customerId String
  userId     String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation("CustomerAssistant", fields: [userId], references: [id], onDelete: Cascade)

  @@id([customerId, userId])
  @@index([userId])
}

model CustomerTag {
  customerId String
  tagValue   String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, tagValue])
}

model CustomerClaimRequest {
  id          String              @id @default(cuid())
  customerId  String
  requesterId String
  status      CustomerClaimStatus @default(PENDING)
  message     String?
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requester User     @relation("ClaimRequester", fields: [requesterId], references: [id])
  reviewer  User?    @relation("ClaimReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([requesterId])
}

model CustomerRelation {
  id                String   @id @default(cuid())
  customerId        String
  relatedCustomerId String
  relationNote      String?
  createdAt         DateTime @default(now())

  customer        Customer @relation("CustomerFrom", fields: [customerId], references: [id], onDelete: Cascade)
  relatedCustomer Customer @relation("CustomerTo", fields: [relatedCustomerId], references: [id], onDelete: Cascade)

  @@unique([customerId, relatedCustomerId])
}

model Contact {
  id          String      @id @default(cuid())
  customerId  String
  name        String
  title       String?
  department  String?
  phone       String?
  wechat      String?
  email       String?
  role        String      @default("OTHER")
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  followUps        FollowUp[]
  followUpLinks    FollowUpContact[]
  checkIns         SalesCheckIn[]
  contractsAsSign  Contract[] @relation("ContractSignContact")
}

// ─── CRM: Follow-up & Face Visit ─────────────────────────

model FollowUp {
  id                    String         @id @default(cuid())
  customerId            String
  contactId             String?
  userId                String
  method                FollowUpMethod
  content               String
  result                String?
  followUpAt            DateTime
  nextFollowUpAt        DateTime?
  nextFollowUpMethod    FollowUpMethod?
  nextFollowUpContent   String?
  suggestedGrade        String?
  gradeApplied          Boolean        @default(false)
  opportunityId         String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id])
  linkedContacts FollowUpContact[]
  user           User             @relation(fields: [userId], references: [id])
  opportunity    Opportunity?     @relation(fields: [opportunityId], references: [id])
  salesTask      SalesTask?
  salesCheckIn   SalesCheckIn?
  salesDailyLog  SalesDailyLog?   @relation(fields: [salesDailyLogId], references: [id])
  salesDailyLogId String?
  weeklyAssignment SalesWeeklyAssignment?
}

model FollowUpContact {
  followUpId String
  contactId  String

  followUp FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([followUpId, contactId])
}

// ─── CRM: Opportunity ────────────────────────────────────

model Opportunity {
  id                String            @id @default(cuid())
  title             String
  customerId        String
  ownerId           String
  expectedAmount    Decimal
  expectedCloseDate DateTime
  stage             String
  requirementDesc   String?
  winProbability    Int?
  competitor        String?
  status            OpportunityStatus @default(NOT_SIGNED)
  amountLocked      Boolean           @default(false)
  abandonReason     OpportunityAbandonReason?
  abandonNote       String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer   Customer                @relation(fields: [customerId], references: [id])
  owner      User                    @relation("OpportunityOwner", fields: [ownerId], references: [id])
  contracts  Contract[]
  stageLogs  OpportunityStageLog[]
  followUps  OpportunityFollowUp[]
  linkedFollowUps FollowUp[]
  weeklyAssignments SalesWeeklyAssignment[]
  planItems         SalesPlanItem[]

  @@index([ownerId])
  @@index([customerId])
  @@index([status])
  @@index([stage])
}

model OpportunityStageLog {
  id            String   @id @default(cuid())
  opportunityId String
  userId        String
  fromStage     String?
  toStage       String
  note          String?
  createdAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([opportunityId])
}

model OpportunityFollowUp {
  id             String         @id @default(cuid())
  opportunityId  String
  userId         String
  method         FollowUpMethod
  content        String
  followUpAt     DateTime
  nextFollowUpAt DateTime?
  nextFollowUpContent String?
  changeSummary  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([opportunityId])
}

// ─── CRM: Contract ───────────────────────────────────────

model Contract {
  id                  String         @id @default(cuid())
  contractNo          String?        @unique
  title               String
  totalAmount         Decimal
  signingType         SigningType
  status              ContractStatus @default(PENDING_APPROVAL)
  signCustomerId      String
  endUserCustomerId   String
  signContactId       String?
  ourRepresentativeId String?
  paymentMethod       String?
  ownerId             String
  opportunityId       String?
  signedAt            DateTime?
  effectiveAt         DateTime?
  expiresAt           DateTime?
  notes               String?
  submittedAt         DateTime?
  submittedById       String?
  approvedAt          DateTime?
  approvedById        String?
  rejectedAt          DateTime?
  rejectReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  signCustomer      Customer                 @relation("SignCustomer", fields: [signCustomerId], references: [id])
  endUserCustomer   Customer                 @relation("EndUserCustomer", fields: [endUserCustomerId], references: [id])
  signContact       Contact?                 @relation("ContractSignContact", fields: [signContactId], references: [id])
  ourRepresentative User?                    @relation("ContractOurRep", fields: [ourRepresentativeId], references: [id])
  owner             User                     @relation("ContractOwner", fields: [ownerId], references: [id])
  submittedBy       User?                    @relation("ContractSubmitter", fields: [submittedById], references: [id])
  approvedBy        User?                    @relation("ContractApprover", fields: [approvedById], references: [id])
  opportunity       Opportunity?             @relation(fields: [opportunityId], references: [id])
  products          ContractProduct[]
  installments      PaymentInstallment[]
  paymentRecords    ContractPaymentRecord[]
  project           Project?

  @@index([opportunityId])
  @@index([status])
}

model ContractProduct {
  id                   String  @id @default(cuid())
  contractId           String
  productServiceId     String?
  productName          String
  description          String?
  costAmount           Decimal @default(0)
  salesAmount          Decimal @default(0)
  baselineCostPrice    Decimal @default(0)
  actualCostPrice      Decimal @default(0)
  costAdjustment       Decimal @default(0)
  costAdjustmentReason String?

  contract       Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productService ProductServiceTemplate? @relation(fields: [productServiceId], references: [id])
}

model ContractPaymentRecord {
  id           String   @id @default(cuid())
  contractId   String
  amount       Decimal
  paidAt       DateTime
  notes        String?
  recordedById String
  createdAt    DateTime @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("ContractPaymentRecorder", fields: [recordedById], references: [id])

  @@index([contractId])
  @@index([paidAt])
}

model PaymentInstallment {
  id            String        @id @default(cuid())
  contractId    String
  periodNumber  Int
  amount        Decimal
  condition     String?
  phaseId       String?
  dueAt         DateTime?
  paymentStatus PaymentStatus @default(UNPAID)
  paidAmount    Decimal       @default(0)
  paidAt        DateTime?
  notes         String?

  contract Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  phase    ProjectPhase?  @relation(fields: [phaseId], references: [id])
}

// ─── PM: Project ─────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  name            String
  contractId      String?       @unique
  customerId      String
  projectManagerId String?
  status          ProjectStatus @default(PENDING_START)
  progressPercent Int           @default(0)
  plannedStartAt  DateTime?
  plannedEndAt    DateTime?
  actualStartAt   DateTime?
  actualEndAt     DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contract       Contract?       @relation(fields: [contractId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  projectManager User?           @relation("ProjectManager", fields: [projectManagerId], references: [id])
  phases         ProjectPhase[]
  members        ProjectMember[]
  tasks          Task[]
  costs          ProjectCost[]
}

model ProjectPhase {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  sourceProduct String?
  sortOrder   Int
  parallelGroup Int?
  status      PhaseStatus @default(NOT_STARTED)
  plannedAt   DateTime?
  completedAt DateTime?

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  installments PaymentInstallment[]
}

model ProjectMember {
  id               String @id @default(cuid())
  projectId        String
  userId           String
  memberRole       PersonnelType
  isProjectManager Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  phaseId     String?
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  creatorId   String
  dueAt       DateTime?
  estimatedHours Decimal?
  actualHours    Decimal?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    ProjectPhase? @relation(fields: [phaseId], references: [id])
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User          @relation("TaskCreator", fields: [creatorId], references: [id])
}

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  recordedById String
  category    String
  amount      Decimal
  costDate    DateTime
  description String?
  createdAt   DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])
}

// ─── Product/Service Templates ───────────────────────────

model ProductServiceTemplate {
  id               String  @id @default(cuid())
  name             String
  description      String?
  baselineCostPrice Decimal @default(0)
  enabled          Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  phaseTemplates   PhaseTemplate[]
  contractProducts ContractProduct[]
}

model PhaseTemplate {
  id              String @id @default(cuid())
  productServiceId String
  name            String
  sortOrder       Int
  parallelGroup   Int?

  productService ProductServiceTemplate @relation(fields: [productServiceId], references: [id], onDelete: Cascade)
}

// ─── Sales: Targets, Tasks, Logs, Costs ──────────────────

model SalesTarget {
  id            String  @id @default(cuid())
  userId        String
  year          Int
  salesTarget   Decimal
  costTarget    Decimal
  profitTarget  Decimal
  paymentTarget Decimal

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year])
}

model SalesMonthlyTarget {
  id            String  @id @default(cuid())
  userId        String
  year          Int
  month         Int
  salesTarget   Decimal
  costTarget    Decimal
  profitTarget  Decimal
  paymentTarget Decimal
  channelDevTarget        Int?
  projectDevTarget        Int?
  paymentCollectionTarget Decimal?
  maintenanceTarget       Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([userId, year])
}

model SalesTask {
  id          String        @id @default(cuid())
  userId      String
  customerId  String
  taskType    SalesTaskType
  plannedAt   DateTime
  status      String        @default("pending")
  notes       String?
  followUpId  String?       @unique
  createdAt   DateTime      @default(now())

  user     User      @relation(fields: [userId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  followUp FollowUp? @relation(fields: [followUpId], references: [id])
}

model SalesWeeklyAssignment {
  id            String                      @id @default(cuid())
  createdById   String
  assigneeId    String
  customerId    String?
  opportunityId String?
  title         String
  description   String?
  dueAt         DateTime
  status        SalesWeeklyAssignmentStatus @default(PENDING)
  completedAt   DateTime?
  followUpId    String?                     @unique
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  createdBy   User         @relation("WeeklyAssignmentCreator", fields: [createdById], references: [id])
  assignee    User         @relation("WeeklyAssignmentAssignee", fields: [assigneeId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  followUp    FollowUp?    @relation(fields: [followUpId], references: [id])

  @@index([assigneeId, status, dueAt])
  @@index([createdById])
}

model SalesPlanBoard {
  id        String          @id @default(cuid())
  userId    String
  period    SalesPlanPeriod
  year      Int
  month     Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SalesPlanItem[]

  @@unique([userId, period, year, month])
  @@index([userId, year])
}

model SalesPlanItem {
  id            String              @id @default(cuid())
  boardId       String
  title         String
  description   String?
  status        SalesPlanItemStatus @default(TODO)
  sortOrder     Int                 @default(0)
  dueAt         DateTime?
  customerId    String?
  opportunityId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  board       SalesPlanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  customer    Customer?      @relation(fields: [customerId], references: [id])
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id])

  @@index([boardId, status, sortOrder])
}

model SalesCheckIn {
  id              String             @id @default(cuid())
  userId          String
  customerId      String?
  contactId       String?
  checkedInAt     DateTime           @default(now())
  latitude        Float?
  longitude       Float?
  locationText    String?
  addressProvince String?
  addressCity     String?
  addressDistrict String?
  addressStreet   String?
  notes           String?
  status          SalesCheckInStatus @default(PENDING)
  followUpId      String?            @unique
  salesDailyLogId String?

  user          User           @relation("SalesCheckInUser", fields: [userId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  contact       Contact?       @relation(fields: [contactId], references: [id])
  followUp      FollowUp?      @relation(fields: [followUpId], references: [id])
  salesDailyLog SalesDailyLog? @relation(fields: [salesDailyLogId], references: [id])

  @@index([userId, checkedInAt])
  @@index([customerId])
}

model SalesDailyLog {
  id                String              @id @default(cuid())
  userId            String
  logDate           DateTime
  conversation      Json
  structuredOutput  Json?
  dailyReport       String?
  status            SalesDailyLogStatus @default(IN_PROGRESS)
  riskFlag          Boolean             @default(false)
  riskNotes         String?
  submittedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  followUps FollowUp[]
  checkIns  SalesCheckIn[]

  @@unique([userId, logDate])
}

model SalesKpiConfig {
  id                      String   @id @default("default")
  projectDevMinStageValue String?
  updatedAt               DateTime @updatedAt
}

model SalesCost {
  id                   String        @id @default(cuid())
  salesUserId          String
  recordedById         String
  costType             SalesCostType
  totalAmount          Decimal
  costDate             DateTime
  customerId           String?
  presalesUserId       String?
  presalesDays         Int?
  presalesPersonnelCost Decimal?
  accommodation        Decimal?
  transportation       Decimal?
  meals                Decimal?
  otherTravel          Decimal?
  accommodationNote    String?
  transportationNote   String?
  mealsNote            String?
  otherTravelNote      String?
  description          String?
  createdAt            DateTime      @default(now())

  salesUser    User      @relation("SalesCostSalesUser", fields: [salesUserId], references: [id])
  recordedBy   User      @relation("SalesCostRecorder", fields: [recordedById], references: [id])
  customer     Customer? @relation("BusinessExpenseCustomer", fields: [customerId], references: [id])
  presalesUser User?     @relation("PresalesCostUser", fields: [presalesUserId], references: [id])
}

model PresalesAssignment {
  id             String                   @id @default(cuid())
  presalesUserId String
  salesUserId    String
  customerId     String
  assignedById   String
  startDate      DateTime
  endDate        DateTime?
  status         PresalesAssignmentStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime                 @default(now())

  presalesUser User     @relation("PresalesStaff", fields: [presalesUserId], references: [id])
  salesUser    User     @relation("PresalesSalesUser", fields: [salesUserId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
  assignedBy   User     @relation("PresalesAssigner", fields: [assignedById], references: [id])
}

// ─── System Config ───────────────────────────────────────

model FieldDefinition {
  id         String  @id @default(cuid())
  entityType String
  fieldKey   String
  label      String
  fieldType  String
  options    Json?
  required   Boolean @default(false)
  enabled    Boolean @default(true)
  builtIn    Boolean @default(false)
  sortOrder  Int     @default(0)

  @@unique([entityType, fieldKey])
}

model PermissionRule {
  id       String  @id @default(cuid())
  role     UserRole
  resource String
  action   String
  scope    String
  enabled  Boolean @default(true)

  @@unique([role, resource, action])
}

model ConfigOption {
  id         String @id @default(cuid())
  category   String
  value      String
  label      String
  sortOrder  Int    @default(0)
  color                String?
  enabled              Boolean @default(true)
  followUpIntervalDays Int?

  @@unique([category, value])
}

model AiAgentConfig {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  provider              String   @default("kimi")
  apiKey                String?
  apiBase               String   @default("https://api.moonshot.cn/v1")
  model                 String   @default("kimi-k2.5")
  maxSteps              Int      @default(5)
  thinkingEnabled       Boolean  @default(false)
  salesLogSystemPrompt  String?
  toolSearchCustomers   Boolean  @default(true)
  toolSearchOpportunities Boolean @default(true)
  toolGetCustomer       Boolean  @default(true)
  toolListFollowUps     Boolean  @default(true)
  sttApiKey             String?
  sttApiBase            String   @default("https://api.siliconflow.cn/v1")
  sttModel              String   @default("FunAudioLLM/SenseVoiceSmall")
  updatedAt             DateTime @updatedAt
  updatedById           String?

  updatedBy User? @relation("AiAgentConfigUpdater", fields: [updatedById], references: [id])
}

model AmapConfig {
  id              String   @id @default("default")
  webServiceKey   String?
  jsKey           String?
  updatedAt       DateTime @updatedAt
  updatedById     String?

  updatedBy User? @relation("AmapConfigUpdater", fields: [updatedById], references: [id])
}
