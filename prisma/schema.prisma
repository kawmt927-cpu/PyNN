generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  SALES
  SALES_MANAGER
  PROJECT_ADMIN
  PROJECT_MANAGER
  PROJECT_STAFF
  ADMIN
  /** 行政人事（报销等能力后续再做） */
  HR
}

enum StaffCategory {
  SALES
  IMPLEMENTATION
}

enum PersonnelType {
  PROJECT_MANAGER
  CONSULTANT
  IMPLEMENTER
  DEVELOPER
}

enum CustomerCategory {
  HOSPITAL
  COMPANY
  INDIVIDUAL
}

enum HospitalLevel {
  GRADE_3A
  GRADE_3B
  GRADE_3
  GRADE_2A
  GRADE_2B
  GRADE_2
  OTHER
}

enum FollowUpMethod {
  PHONE
  WECHAT
  FACE_VISIT
  ONLINE_MEETING
  OTHER
}

enum SigningType {
  DIRECT
  INDIRECT
}

enum ContractStatus {
  PENDING_APPROVAL
  REJECTED
  PENDING_SIGN
  SIGNED_PENDING_IMPL
  IMPLEMENTING
  ACCEPTED
  MAINTAINING
  TERMINATED
}

enum OpportunityStatus {
  NOT_SIGNED
  SIGNED
  ABANDONED
}

enum DealPartyRole {
  PRIMARY
  CHANNEL
  THIRD_PARTY
  OTHER
}

enum OpportunityAbandonReason {
  PRICE
  BUSINESS_RELATIONSHIP
  OPERATION_ERROR
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum ContractProductCostType {
  INTERNAL
  EXTERNAL
}

enum ProjectStatus {
  PENDING_START
  IMPLEMENTING
  ACCEPTED
  MAINTAINING
  CLOSED
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum AllocationMode {
  AUTO
  MANUAL
}

enum TaskStatus {
  PENDING_APPROVAL
  PENDING
  IN_PROGRESS
  PENDING_REVIEW
  COMPLETED
  BLOCKED
  REJECTED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

/// 项目计划任务状态（与销售 CRM Task 独立）
enum ProjectTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SalesCostType {
  PERSONAL_TRAVEL
  PRESALES
  BUSINESS
}

enum SalesTaskType {
  VISIT
  COMMUNICATE
  FOLLOW_UP
}

enum SalesDailyLogStatus {
  IN_PROGRESS
  PENDING_CONFIRM
  SUBMITTED
  RISK_SUBMITTED
}

enum SalesDailyLogRiskFlag {
  NONE
  RISK
}

enum SalesCheckInStatus {
  PENDING
  COMPLETED
}

enum SalesWeeklyAssignmentStatus {
  PENDING
  PENDING_CONFIRM
  COMPLETED
  CANCELLED
}

enum SalesWeeklyAssignmentKind {
  CUSTOMER_FOLLOW_UP
  GENERAL
}

enum SalesPlanPeriod {
  YEAR
  MONTH
}

enum SalesPlanItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum PresalesAssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CustomerClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WeComAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseClaimStatus {
  DRAFT
  PENDING_MANAGER
  REJECTED
  PENDING_PAYOUT
  PAID
}

enum ExpenseCostTarget {
  SALES
  PROJECT
  NONE
}

enum ExpenseApprovalStep {
  MANAGER
  FINANCE
}

enum ExpenseApprovalAction {
  APPROVED
  REJECTED
}

// ─── User & Personnel ────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  /** 可选；登录主标识为手机号 */
  email         String?   @unique
  /** 登录账号（大陆手机号） */
  phone         String?   @unique
  name          String
  passwordHash  String?
  role          UserRole  @default(SALES)
  wecomUserId   String?   @unique
  /** 是否计入销售团队业绩（临时配置，后续可迁到权限） */
  includeInTeamPerformance Boolean @default(true)
  /** 是否参与月度 KPI 考核（临时配置，后续可迁到权限） */
  includeInMonthlyAssessment Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  personnelProfile   PersonnelProfile?
  contractAttachmentsUploaded ContractAttachment[]
  contractInvoiceAttachmentsUploaded ContractInvoiceAttachment[] @relation("ContractInvoiceAttachmentUploader")
  ownedCustomers     Customer[]           @relation("CustomerOwner")
  followUps          FollowUp[]
  contracts          Contract[]           @relation("ContractOwner")
  salesTargets        SalesTarget[]
  salesMonthlyTargets SalesMonthlyTarget[]
  salesTasks         SalesTask[]
  salesDailyLogs     SalesDailyLog[]
  salesCostsIncurred SalesCost[]          @relation("SalesCostSalesUser")
  salesCostsRecorded SalesCost[]          @relation("SalesCostRecorder")
  projectMembers     ProjectMember[]
  assignedTasks      Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  assignedProjectTasks ProjectTask[]      @relation("ProjectTaskAssignee")
  managedProjects    Project[]            @relation("ProjectManager")
  presalesAssigned   PresalesAssignment[] @relation("PresalesStaff")
  presalesCreated    PresalesAssignment[] @relation("PresalesAssigner")
  presalesCostFor    SalesCost[]          @relation("PresalesCostUser")
  presalesSalesFor   PresalesAssignment[] @relation("PresalesSalesUser")
  projectCosts       ProjectCost[]
  staffAllocations   ProjectStaffAllocation[]
  monthlyCostAdjustments PersonnelMonthlyCostAdjustment[]
  customerClaimsRequested CustomerClaimRequest[] @relation("ClaimRequester")
  customerClaimsReviewed  CustomerClaimRequest[] @relation("ClaimReviewer")
  contractsAsOurRep       Contract[]             @relation("ContractOurRep")
  contractsSubmitted      Contract[]             @relation("ContractSubmitter")
  contractsApproved       Contract[]             @relation("ContractApprover")
  contractPaymentsRecorded ContractPaymentRecord[] @relation("ContractPaymentRecorder")
  contractInvoicesRecorded ContractInvoiceRecord[] @relation("ContractInvoiceRecorder")
  externalCostPayoutsRecorded ExternalCostPayoutRecord[] @relation("ExternalCostPayoutRecorder")
  ownedOpportunities      Opportunity[]          @relation("OpportunityOwner")
  opportunityStageLogs    OpportunityStageLog[]
  projectDevReviews       OpportunityStageLog[]  @relation("ProjectDevReviewer")
  opportunityFollowUps    OpportunityFollowUp[]
  aiAgentConfigsUpdated   AiAgentConfig[]      @relation("AiAgentConfigUpdater")
  amapConfigsUpdated      AmapConfig[]         @relation("AmapConfigUpdater")
  expenseTravelPoliciesUpdated ExpenseTravelPolicy[] @relation("ExpenseTravelPolicyUpdater")
  salesCheckIns           SalesCheckIn[]       @relation("SalesCheckInUser")
  weeklyAssignmentsCreated SalesWeeklyAssignment[] @relation("WeeklyAssignmentCreator")
  weeklyAssignmentsAssigned SalesWeeklyAssignment[] @relation("WeeklyAssignmentAssignee")
  weeklyAssignmentsConfirmed SalesWeeklyAssignment[] @relation("WeeklyAssignmentConfirmer")
  salesPlanBoards          SalesPlanBoard[]
  assistedCustomers        CustomerAssistant[]      @relation("CustomerAssistant")
  wecomAccessRequestsReviewed WeComAccessRequest[] @relation("WeComAccessReviewer")
  wecomAccessRequest         WeComAccessRequest?
  entityOperationLogs        EntityOperationLog[]
  appNotificationsReceived   AppNotificationReceipt[]
  expenseClaimsSubmitted     ExpenseClaim[]           @relation("ExpenseClaimApplicant")
  expenseClaimsToApprove     ExpenseClaim[]           @relation("ExpenseClaimManager")
  expenseApprovalsActed      ExpenseApproval[]        @relation("ExpenseApprovalActor")
  expensePayoutsRecorded     ExpensePayout[]          @relation("ExpensePayoutRecorder")
  expenseInvoicesSuggestedPresales ExpenseInvoice[]   @relation("ExpenseInvoicePresales")
}



model WeComAccessRequest {
  id           String            @id @default(cuid())
  wecomUserId  String
  name         String
  phone        String
  passwordHash String?
  message      String?
  status       WeComAccessStatus @default(PENDING)
  reviewerId   String?
  reviewNote   String?
  reviewedAt   DateTime?
  userId       String?           @unique
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  reviewer User? @relation("WeComAccessReviewer", fields: [reviewerId], references: [id])
  user     User? @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([wecomUserId])
  @@index([phone])
}

model PersonnelProfile {
  id                     String         @id @default(cuid())
  userId                 String         @unique
  staffCategory          StaffCategory
  personnelType          PersonnelType?
  isPresales             Boolean        @default(false)
  /** 缴费基数（元/月） */
  contributionBase       Decimal?
  /** 基本工资（元/月） */
  baseSalary             Decimal?
  /** 社保公司承担（元/月） */
  socialSecurityCompany  Decimal?
  /** 公积金公司承担（元/月） */
  housingFundCompany     Decimal?
  /** 日单价缓存（可选；项目核算以月成本÷当月工作日为准） */
  dailyRate              Decimal?
  enabled                Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 某自然月的人员成本（可维护历史；含请假等调整）
model PersonnelMonthlyCostAdjustment {
  id                     String   @id @default(cuid())
  userId                 String
  year                   Int
  month                  Int
  /** 缴费基数（元/月）；空则回退档案默认 */
  contributionBase       Decimal?
  /** 基本工资（元/月） */
  baseSalary             Decimal?
  /** 社保公司承担（元/月） */
  socialSecurityCompany  Decimal?
  /** 公积金公司承担（元/月） */
  housingFundCompany     Decimal?
  /** 相对本月固定成本的增减（元，可为负） */
  adjustmentAmount       Decimal  @default(0)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId, year, month])
}

// ─── CRM: Customer ───────────────────────────────────────

model Customer {
  id              String           @id @default(cuid())
  name            String
  category        CustomerCategory
  hospitalLevel   HospitalLevel?
  province        String?
  city            String?
  district        String?
  bedCount        Int?
  existingSystem  String?
  source          String?
  customerType    String?
  customerGrade   String?
  ownerId         String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  owner              User?              @relation("CustomerOwner", fields: [ownerId], references: [id])
  contacts           Contact[]
  followUps          FollowUp[]
  contractsAsSign    Contract[]         @relation("SignCustomer")
  contractsAsEndUser Contract[]         @relation("EndUserCustomer")
  projects           Project[]
  salesTasks         SalesTask[]
  salesCosts         SalesCost[]        @relation("BusinessExpenseCustomer")
  presalesAssignments PresalesAssignment[]

  relationsFrom CustomerRelation[] @relation("CustomerFrom")
  relationsTo   CustomerRelation[] @relation("CustomerTo")
  claimRequests CustomerClaimRequest[]
  opportunities Opportunity[]
  opportunityParties OpportunityParty[]
  contractParties    ContractParty[]
  salesCheckIns SalesCheckIn[]
  tags          CustomerTag[]
  weeklyAssignments SalesWeeklyAssignment[]
  planItems         SalesPlanItem[]
  assistantOwners   CustomerAssistant[]
  expenseTrips      ExpenseTrip[]
  expenseInvoices   ExpenseInvoice[]
}

model CustomerAssistant {
  customerId String
  userId     String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation("CustomerAssistant", fields: [userId], references: [id], onDelete: Cascade)

  @@id([customerId, userId])
  @@index([userId])
}

model CustomerTag {
  customerId String
  tagValue   String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, tagValue])
}

model CustomerClaimRequest {
  id          String              @id @default(cuid())
  customerId  String
  requesterId String
  status      CustomerClaimStatus @default(PENDING)
  message     String?
  reviewerId  String?
  reviewNote  String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requester User     @relation("ClaimRequester", fields: [requesterId], references: [id])
  reviewer  User?    @relation("ClaimReviewer", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([requesterId])
}

model CustomerRelation {
  id                String   @id @default(cuid())
  customerId        String
  relatedCustomerId String
  relationNote      String?
  createdAt         DateTime @default(now())

  customer        Customer @relation("CustomerFrom", fields: [customerId], references: [id], onDelete: Cascade)
  relatedCustomer Customer @relation("CustomerTo", fields: [relatedCustomerId], references: [id], onDelete: Cascade)

  @@unique([customerId, relatedCustomerId])
}

model Contact {
  id          String      @id @default(cuid())
  customerId  String
  name        String
  title       String?
  department  String?
  phone       String?
  wechat      String?
  email       String?
  role        String      @default("OTHER")
  isPrimary   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  followUps        FollowUp[]
  followUpLinks    FollowUpContact[]
  checkIns         SalesCheckIn[]
  contractsAsSign  Contract[] @relation("ContractSignContact")
}

// ─── CRM: Follow-up & Face Visit ─────────────────────────

model FollowUp {
  id                    String         @id @default(cuid())
  customerId            String
  contactId             String?
  userId                String
  method                FollowUpMethod
  content               String
  result                String?
  followUpAt            DateTime
  nextFollowUpAt        DateTime?
  nextFollowUpMethod    FollowUpMethod?
  nextFollowUpContent   String?
  suggestedGrade        String?
  gradeApplied          Boolean        @default(false)
  opportunityId         String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id])
  linkedContacts FollowUpContact[]
  user           User             @relation(fields: [userId], references: [id])
  opportunity    Opportunity?     @relation(fields: [opportunityId], references: [id])
  linkedOpportunities FollowUpOpportunity[]
  salesTask      SalesTask?
  salesCheckIn   SalesCheckIn?
  salesDailyLog  SalesDailyLog?   @relation(fields: [salesDailyLogId], references: [id])
  salesDailyLogId String?
  weeklyAssignment SalesWeeklyAssignment?
}

model FollowUpContact {
  followUpId String
  contactId  String

  followUp FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([followUpId, contactId])
}

model FollowUpOpportunity {
  followUpId    String
  opportunityId String

  followUp    FollowUp    @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([followUpId, opportunityId])
  @@index([opportunityId])
}

// ─── CRM: Opportunity ────────────────────────────────────

model Opportunity {
  id                String            @id @default(cuid())
  title             String
  /** 主要客户（可选；渠道/第三方等放 parties） */
  customerId        String?
  ownerId           String
  expectedAmount    Decimal
  expectedCloseDate DateTime
  stage             String
  /** 商机等级 P0–P3（配置 opportunity_grade） */
  grade             String?
  requirementDesc   String?
  winProbability    Int?
  competitor        String?
  status            OpportunityStatus @default(NOT_SIGNED)
  amountLocked      Boolean           @default(false)
  abandonReason     OpportunityAbandonReason?
  abandonNote       String?
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  customer   Customer?               @relation(fields: [customerId], references: [id])
  owner      User                    @relation("OpportunityOwner", fields: [ownerId], references: [id])
  parties    OpportunityParty[]
  contracts  Contract[]
  stageLogs  OpportunityStageLog[]
  followUps  OpportunityFollowUp[]
  linkedFollowUps FollowUp[]
  followUpLinks   FollowUpOpportunity[]
  weeklyAssignments SalesWeeklyAssignment[]
  planItems         SalesPlanItem[]

  @@index([ownerId])
  @@index([customerId])
  @@index([status])
  @@index([stage])
  @@index([grade])
}

/** 商机额外关联客户（渠道/第三方等；主要客户用 Opportunity.customerId） */
model OpportunityParty {
  id            String        @id @default(cuid())
  opportunityId String
  customerId    String
  role          DealPartyRole
  note          String?
  createdAt     DateTime      @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@unique([opportunityId, customerId])
  @@index([customerId])
  @@index([opportunityId, role])
}

model OpportunityStageLog {
  id                   String    @id @default(cuid())
  opportunityId        String
  userId               String
  fromStage            String?
  toStage              String
  note                 String?
  /** 项目开发 KPI 人工核算：null=待核算 true=计入 false=不计入 */
  countedAsProjectDev  Boolean?
  reviewedAt           DateTime?
  reviewedById         String?
  createdAt            DateTime  @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])
  reviewedBy  User?       @relation("ProjectDevReviewer", fields: [reviewedById], references: [id])

  @@index([opportunityId])
  @@index([createdAt])
  @@index([countedAsProjectDev])
}

model OpportunityFollowUp {
  id             String         @id @default(cuid())
  opportunityId  String
  userId         String
  method         FollowUpMethod
  content        String
  followUpAt     DateTime
  nextFollowUpAt DateTime?
  nextFollowUpContent String?
  changeSummary  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@index([opportunityId])
}

// ─── CRM: Contract ───────────────────────────────────────

model Contract {
  id                  String         @id @default(cuid())
  contractNo          String?        @unique
  title               String
  totalAmount         Decimal
  signingType         SigningType
  status              ContractStatus @default(PENDING_APPROVAL)
  signCustomerId      String
  endUserCustomerId   String
  signContactId       String?
  ourRepresentativeId String?
  paymentMethod       String?
  ownerId             String
  opportunityId       String?
  signedAt            DateTime?
  effectiveAt         DateTime?
  expiresAt           DateTime?
  notes               String?
  submittedAt         DateTime?
  submittedById       String?
  approvedAt          DateTime?
  approvedById        String?
  rejectedAt          DateTime?
  rejectReason        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  signCustomer      Customer                 @relation("SignCustomer", fields: [signCustomerId], references: [id])
  endUserCustomer   Customer                 @relation("EndUserCustomer", fields: [endUserCustomerId], references: [id])
  signContact       Contact?                 @relation("ContractSignContact", fields: [signContactId], references: [id])
  ourRepresentative User?                    @relation("ContractOurRep", fields: [ourRepresentativeId], references: [id])
  owner             User                     @relation("ContractOwner", fields: [ownerId], references: [id])
  submittedBy       User?                    @relation("ContractSubmitter", fields: [submittedById], references: [id])
  approvedBy        User?                    @relation("ContractApprover", fields: [approvedById], references: [id])
  opportunity       Opportunity?             @relation(fields: [opportunityId], references: [id])
  parties           ContractParty[]
  products          ContractProduct[]
  installments      PaymentInstallment[]
  paymentRecords    ContractPaymentRecord[]
  invoiceRecords    ContractInvoiceRecord[]
  externalPayoutRecords ExternalCostPayoutRecord[]
  attachments       ContractAttachment[]
  project           Project?

  @@index([opportunityId])
  @@index([status])
}

/** 合同额外关联客户（渠道/第三方等；签约/最终用户用既有 FK） */
model ContractParty {
  id         String        @id @default(cuid())
  contractId String
  customerId String
  role       DealPartyRole
  note       String?
  createdAt  DateTime      @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([contractId, customerId])
  @@index([customerId])
  @@index([contractId, role])
}

model ContractAttachment {
  id           String   @id @default(cuid())
  contractId   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  uploadedById String
  createdAt    DateTime @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([contractId])
}

model ContractProduct {
  id                   String                 @id @default(cuid())
  contractId           String
  productServiceId     String?
  productName          String
  description          String?
  costType             ContractProductCostType @default(INTERNAL)
  costAmount           Decimal                @default(0)
  salesAmount          Decimal                @default(0)
  baselineCostPrice    Decimal                @default(0)
  actualCostPrice      Decimal                @default(0)
  costAdjustment       Decimal                @default(0)
  costAdjustmentReason String?

  contract              Contract                   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productService        ProductServiceTemplate?    @relation(fields: [productServiceId], references: [id])
  externalInstallments  ExternalCostInstallment[]
  externalPayoutRecords ExternalCostPayoutRecord[]

  @@index([contractId])
  @@index([costType])
}

model ExternalCostInstallment {
  id                String    @id @default(cuid())
  contractProductId String
  periodNumber      Int
  amount            Decimal
  condition         String?
  dueAt             DateTime?

  contractProduct ContractProduct @relation(fields: [contractProductId], references: [id], onDelete: Cascade)

  @@index([contractProductId])
  @@unique([contractProductId, periodNumber])
}

model ExternalCostPayoutRecord {
  id                String   @id @default(cuid())
  contractId        String
  contractProductId String
  amount            Decimal
  paidAt            DateTime
  notes             String?
  recordedById      String
  createdAt         DateTime @default(now())

  contract        Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractProduct ContractProduct @relation(fields: [contractProductId], references: [id], onDelete: Cascade)
  recordedBy      User            @relation("ExternalCostPayoutRecorder", fields: [recordedById], references: [id])

  @@index([contractId])
  @@index([contractProductId])
  @@index([paidAt])
}

model ContractPaymentRecord {
  id           String   @id @default(cuid())
  contractId   String
  amount       Decimal
  paidAt       DateTime
  notes        String?
  recordedById String
  createdAt    DateTime @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("ContractPaymentRecorder", fields: [recordedById], references: [id])

  @@index([contractId])
  @@index([paidAt])
}

/** 合同开票记录：可多条登记；合计允许超过合同金额 */
model ContractInvoiceRecord {
  id              String   @id @default(cuid())
  contractId      String
  amount          Decimal
  /** 税率「几个点」，如 6 表示 6% */
  taxRatePercent  Decimal
  invoicedAt      DateTime
  invoiceNo       String?
  notes           String?
  recordedById    String
  createdAt       DateTime @default(now())

  contract    Contract                    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  recordedBy  User                        @relation("ContractInvoiceRecorder", fields: [recordedById], references: [id])
  attachments ContractInvoiceAttachment[]

  @@index([contractId])
  @@index([invoicedAt])
}

model ContractInvoiceAttachment {
  id              String   @id @default(cuid())
  invoiceRecordId String
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  uploadedById    String
  createdAt       DateTime @default(now())

  invoiceRecord ContractInvoiceRecord @relation(fields: [invoiceRecordId], references: [id], onDelete: Cascade)
  uploadedBy    User                @relation("ContractInvoiceAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([invoiceRecordId])
}

model PaymentInstallment {
  id            String        @id @default(cuid())
  contractId    String
  periodNumber  Int
  amount        Decimal
  condition     String?
  phaseId       String?
  dueAt         DateTime?
  paymentStatus PaymentStatus @default(UNPAID)
  paidAmount    Decimal       @default(0)
  paidAt        DateTime?
  notes         String?

  contract Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  phase    ProjectPhase?  @relation(fields: [phaseId], references: [id])
}

// ─── PM: Project ─────────────────────────────────────────

model Project {
  id              String        @id @default(cuid())
  name            String
  contractId      String?       @unique
  customerId      String?
  projectManagerId String?
  status          ProjectStatus @default(PENDING_START)
  progressPercent Int           @default(0)
  plannedStartAt  DateTime?
  plannedEndAt    DateTime?
  actualStartAt   DateTime?
  actualEndAt     DateTime?
  notes           String?
  /** 最近套用的项目模型（供模板任务可选项） */
  sourceModelId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contract       Contract?       @relation(fields: [contractId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  projectManager User?           @relation("ProjectManager", fields: [projectManagerId], references: [id])
  sourceModel    ProjectModel?   @relation(fields: [sourceModelId], references: [id], onDelete: SetNull)
  phases         ProjectPhase[]
  members        ProjectMember[]
  tasks          Task[]
  projectTasks   ProjectTask[]
  costs          ProjectCost[]
  staffAllocations ProjectStaffAllocation[]
  expenseInvoices ExpenseInvoice[]
}

model ProjectPhase {
  id          String      @id @default(cuid())
  projectId   String
  name        String
  sourceProduct String?
  /** 套用时对应的模板阶段 id */
  sourceModelPhaseId String?
  sortOrder   Int
  parallelGroup Int?
  progressWeight Int       @default(0)
  status      PhaseStatus @default(NOT_STARTED)
  /** @deprecated 兼容旧数据；新逻辑用 plannedStartAt/plannedEndAt */
  plannedAt   DateTime?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  completedAt DateTime?

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]
  projectTasks ProjectTask[]
  installments PaymentInstallment[]
  staffAllocations ProjectStaffAllocation[]
}

/// 项目计划任务（与销售 CRM Task 独立）
model ProjectTask {
  id                 String            @id @default(cuid())
  projectId          String
  phaseId            String
  name               String
  description        String?
  status             ProjectTaskStatus @default(NOT_STARTED)
  plannedStartAt     DateTime
  plannedEndAt       DateTime
  /// 实际完成时间（计划区间已全部落在过去时可填）
  actualCompletedAt  DateTime?
  /// 任务取消/作废备注
  cancelledNote      String?
  assigneeId         String?
  sourceModelTaskId  String?
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignee User?        @relation("ProjectTaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId, phaseId, sortOrder])
  @@index([phaseId, sortOrder])
}

model ProjectMember {
  id               String @id @default(cuid())
  projectId        String
  userId           String
  memberRole       PersonnelType
  isProjectManager Boolean @default(false)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  phaseId     String?
  title       String
  description String?
  status      TaskStatus   @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  creatorId   String
  dueAt       DateTime?
  estimatedHours Decimal?
  actualHours    Decimal?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    ProjectPhase? @relation(fields: [phaseId], references: [id])
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User          @relation("TaskCreator", fields: [creatorId], references: [id])
}

model ProjectCost {
  id          String   @id @default(cuid())
  projectId   String
  recordedById String
  category    String
  amount      Decimal
  costDate    DateTime
  description String?
  createdAt   DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])
  expenseInvoice ExpenseInvoice? @relation("ExpenseInvoicePostedProjectCost")
}

model ProjectStaffAllocation {
  id                String         @id @default(cuid())
  projectId         String
  userId            String
  phaseId           String?
  startDate         DateTime
  endDate           DateTime
  allocationMode    AllocationMode @default(AUTO)
  plannedDays       Decimal?
  splitWeight       Decimal?
  dailyRateSnapshot Decimal
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id])
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id])

  @@index([projectId])
  @@index([userId, startDate, endDate])
}

// ─── Product/Service Templates ───────────────────────────

model ProductServiceTemplate {
  id               String  @id @default(cuid())
  name             String
  description      String?
  baselineCostPrice Decimal @default(0)
  enabled          Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  phaseTemplates   PhaseTemplate[]
  contractProducts ContractProduct[]
}

model PhaseTemplate {
  id              String @id @default(cuid())
  productServiceId String
  name            String
  sortOrder       Int
  parallelGroup   Int?

  productService ProductServiceTemplate @relation(fields: [productServiceId], references: [id], onDelete: Cascade)
}

// ─── Project Models (实施阶段模板) ───────────────────────

model ProjectModel {
  id                String   @id @default(cuid())
  name              String
  description       String?
  enabled           Boolean  @default(true)
  /** 总工期（自然日），决定甘特图长度 */
  totalDurationDays Int      @default(40)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  phases    ProjectModelPhase[]
  nodes     ProjectModelNode[]
  projects  Project[]
}

/// 关键节点：无工期，仅一个时间点（参照 + 浮动）
model ProjectModelNode {
  id         String @id @default(cuid())
  modelId    String
  name       String
  sortOrder  Int
  timeRef    String @default("PROJECT_START")
  timeOffset Int    @default(0)

  model ProjectModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId, sortOrder])
}

/// 阶段起止：参照项目/其他阶段开始或结束 + 浮动；结束可选固定工期
model ProjectModelPhase {
  id             String  @id @default(cuid())
  modelId        String
  name           String
  sortOrder      Int
  /** 按工期占比自动计算并落库 */
  progressWeight Int     @default(0)

  /** 开始参照：PROJECT_START | PROJECT_END | PHASE_START:{id} | PHASE_END:{id} */
  startRef    String @default("PROJECT_START")
  startOffset Int    @default(0)

  /** 结束参照：同上或 DURATION（固定工期） */
  endRef       String @default("DURATION")
  endOffset    Int    @default(0)
  durationDays Int?

  model ProjectModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  tasks ProjectModelTask[]

  @@index([modelId, sortOrder])
}

/// 阶段下的任务模板（名称 + 工期，自然日）
model ProjectModelTask {
  id           String @id @default(cuid())
  phaseId      String
  name         String
  sortOrder    Int
  durationDays Int    @default(1)

  phase ProjectModelPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([phaseId, sortOrder])
}

// ─── Sales: Targets, Tasks, Logs, Costs ──────────────────

model SalesTarget {
  id            String  @id @default(cuid())
  userId        String
  year          Int
  salesTarget   Decimal
  costTarget    Decimal
  profitTarget  Decimal
  paymentTarget Decimal

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year])
}

model SalesMonthlyTarget {
  id            String  @id @default(cuid())
  userId        String
  year          Int
  month         Int
  salesTarget   Decimal
  costTarget    Decimal
  profitTarget  Decimal
  paymentTarget Decimal
  channelDevTarget        Int?
  projectDevTarget        Int?
  paymentCollectionTarget Decimal?
  maintenanceTarget       Int?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@index([userId, year])
}

model SalesTask {
  id          String        @id @default(cuid())
  userId      String
  customerId  String
  taskType    SalesTaskType
  plannedAt   DateTime
  status      String        @default("pending")
  notes       String?
  followUpId  String?       @unique
  createdAt   DateTime      @default(now())

  user     User      @relation(fields: [userId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  followUp FollowUp? @relation(fields: [followUpId], references: [id])
}

model SalesWeeklyAssignment {
  id            String                      @id @default(cuid())
  createdById   String
  assigneeId    String
  customerId    String?
  opportunityId String?
  title         String
  description   String?
  dueAt         DateTime
  kind          SalesWeeklyAssignmentKind   @default(CUSTOMER_FOLLOW_UP)
  status        SalesWeeklyAssignmentStatus @default(PENDING)
  completedAt   DateTime?
  assigneeNote  String?
  confirmedAt   DateTime?
  confirmedById String?
  followUpId    String?                     @unique
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  createdBy   User         @relation("WeeklyAssignmentCreator", fields: [createdById], references: [id])
  assignee    User         @relation("WeeklyAssignmentAssignee", fields: [assigneeId], references: [id])
  confirmedBy User?        @relation("WeeklyAssignmentConfirmer", fields: [confirmedById], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  followUp    FollowUp?    @relation(fields: [followUpId], references: [id])

  @@index([assigneeId, status, dueAt])
  @@index([createdById, status])
  @@index([kind, status])
}

model SalesPlanBoard {
  id        String          @id @default(cuid())
  userId    String
  period    SalesPlanPeriod
  year      Int
  month     Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SalesPlanItem[]

  @@unique([userId, period, year, month])
  @@index([userId, year])
}

model SalesPlanItem {
  id            String              @id @default(cuid())
  boardId       String
  title         String
  description   String?
  status        SalesPlanItemStatus @default(TODO)
  sortOrder     Int                 @default(0)
  dueAt         DateTime?
  customerId    String?
  opportunityId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  board       SalesPlanBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  customer    Customer?      @relation(fields: [customerId], references: [id])
  opportunity Opportunity?   @relation(fields: [opportunityId], references: [id])

  @@index([boardId, status, sortOrder])
}

model SalesCheckIn {
  id              String             @id @default(cuid())
  userId          String
  customerId      String?
  contactId       String?
  checkedInAt     DateTime           @default(now())
  latitude        Float?
  longitude       Float?
  locationText    String?
  addressProvince String?
  addressCity     String?
  addressDistrict String?
  addressStreet   String?
  notes           String?
  status          SalesCheckInStatus @default(PENDING)
  followUpId      String?            @unique
  salesDailyLogId String?
  /** 服务端静默采集，不对销售展示 */
  clientIp            String?
  ipProvince          String?
  ipCity              String?
  locationIpMismatch  Boolean          @default(false)

  user          User           @relation("SalesCheckInUser", fields: [userId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  contact       Contact?       @relation(fields: [contactId], references: [id])
  followUp      FollowUp?      @relation(fields: [followUpId], references: [id])
  salesDailyLog SalesDailyLog? @relation(fields: [salesDailyLogId], references: [id])

  @@index([userId, checkedInAt])
  @@index([customerId])
  @@index([locationIpMismatch, checkedInAt])
}

model SalesDailyLog {
  id                String              @id @default(cuid())
  userId            String
  logDate           DateTime
  conversation      Json
  structuredOutput  Json?
  dailyReport       String?
  status            SalesDailyLogStatus @default(IN_PROGRESS)
  riskFlag          Boolean             @default(false)
  riskNotes         String?
  submittedAt       DateTime?
  /** 20:00 催交已发送 */
  remind20SentAt    DateTime?
  /** 21:00 催交已发送 */
  remind21SentAt    DateTime?
  /** 超过 22:00 未交时锁定的迟交记录；补录不清除 */
  lateMarkedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user      User           @relation(fields: [userId], references: [id])
  followUps FollowUp[]
  checkIns  SalesCheckIn[]

  @@unique([userId, logDate])
}

model SalesKpiConfig {
  id                      String   @id @default("default")
  projectDevMinStageValue String?
  updatedAt               DateTime @updatedAt
}

model SalesCost {
  id                   String        @id @default(cuid())
  salesUserId          String
  recordedById         String
  costType             SalesCostType
  totalAmount          Decimal
  costDate             DateTime
  customerId           String?
  presalesUserId       String?
  presalesDays         Int?
  presalesPersonnelCost Decimal?
  accommodation        Decimal?
  transportation       Decimal?
  meals                Decimal?
  otherTravel          Decimal?
  accommodationNote    String?
  transportationNote   String?
  mealsNote            String?
  otherTravelNote      String?
  description          String?
  createdAt            DateTime      @default(now())

  salesUser    User      @relation("SalesCostSalesUser", fields: [salesUserId], references: [id])
  recordedBy   User      @relation("SalesCostRecorder", fields: [recordedById], references: [id])
  customer     Customer? @relation("BusinessExpenseCustomer", fields: [customerId], references: [id])
  presalesUser User?     @relation("PresalesCostUser", fields: [presalesUserId], references: [id])
  expenseInvoice ExpenseInvoice? @relation("ExpenseInvoicePostedSalesCost")
}

model PresalesAssignment {
  id             String                   @id @default(cuid())
  presalesUserId String
  salesUserId    String
  customerId     String
  assignedById   String
  startDate      DateTime
  endDate        DateTime?
  status         PresalesAssignmentStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime                 @default(now())

  presalesUser User     @relation("PresalesStaff", fields: [presalesUserId], references: [id])
  salesUser    User     @relation("PresalesSalesUser", fields: [salesUserId], references: [id])
  customer     Customer @relation(fields: [customerId], references: [id])
  assignedBy   User     @relation("PresalesAssigner", fields: [assignedById], references: [id])
}

// ─── System Config ───────────────────────────────────────

model FieldDefinition {
  id         String  @id @default(cuid())
  entityType String
  fieldKey   String
  label      String
  fieldType  String
  options    Json?
  required   Boolean @default(false)
  enabled    Boolean @default(true)
  builtIn    Boolean @default(false)
  sortOrder  Int     @default(0)

  @@unique([entityType, fieldKey])
}

model PermissionRule {
  id       String  @id @default(cuid())
  role     UserRole
  resource String
  action   String
  scope    String
  enabled  Boolean @default(true)

  @@unique([role, resource, action])
}

model ConfigOption {
  id         String @id @default(cuid())
  category   String
  value      String
  label      String
  sortOrder  Int    @default(0)
  color                String?
  enabled              Boolean @default(true)
  followUpIntervalDays Int?

  @@unique([category, value])
}

model AiAgentConfig {
  id                    String   @id @default("default")
  enabled               Boolean  @default(false)
  provider              String   @default("kimi")
  apiKey                String?
  apiBase               String   @default("https://api.moonshot.cn/v1")
  model                 String   @default("kimi-k2.5")
  maxSteps              Int      @default(5)
  thinkingEnabled       Boolean  @default(false)
  salesLogSystemPrompt  String?
  toolSearchCustomers   Boolean  @default(true)
  toolSearchOpportunities Boolean @default(true)
  toolGetCustomer       Boolean  @default(true)
  toolListFollowUps     Boolean  @default(true)
  sttApiKey             String?
  sttApiBase            String   @default("https://api.siliconflow.cn/v1")
  sttModel              String   @default("FunAudioLLM/SenseVoiceSmall")
  updatedAt             DateTime @updatedAt
  updatedById           String?

  updatedBy User? @relation("AiAgentConfigUpdater", fields: [updatedById], references: [id])
}

model AmapConfig {
  id              String   @id @default("default")
  webServiceKey   String?
  jsKey           String?
  updatedAt       DateTime @updatedAt
  updatedById     String?

  updatedBy User? @relation("AmapConfigUpdater", fields: [updatedById], references: [id])
}


// ─── Operation log & notifications ───────────────────────

model EntityOperationLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  userId     String
  action     String
  summary    String
  detail     String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model AppNotification {
  id        String   @id @default(cuid())
  type      String
  title     String
  body      String
  linkHref  String?
  metaJson  String?
  createdAt DateTime @default(now())

  receipts AppNotificationReceipt[]

  @@index([createdAt])
  @@index([type, createdAt])
}

model AppNotificationReceipt {
  id             String    @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt, createdAt])
}

// ─── Expense reimbursement ───────────────────────────────

model ExpenseClaim {
  id              String             @id @default(cuid())
  applicantId     String
  managerId       String?
  title           String
  description     String?
  status          ExpenseClaimStatus @default(DRAFT)
  totalAmount     Decimal            @default(0)
  submittedAt     DateTime?
  rejectedAt      DateTime?
  rejectReason    String?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  applicant  User              @relation("ExpenseClaimApplicant", fields: [applicantId], references: [id])
  manager    User?             @relation("ExpenseClaimManager", fields: [managerId], references: [id])
  trips      ExpenseTrip[]
  invoices   ExpenseInvoice[]
  approvals  ExpenseApproval[]
  payout     ExpensePayout?

  @@index([applicantId, status, updatedAt])
  @@index([managerId, status])
  @@index([status, submittedAt])
}

model ExpenseTrip {
  id          String   @id @default(cuid())
  claimId     String
  /** 段序号，支持同一报销单多段行程 */
  sortOrder   Int      @default(0)
  startDate   DateTime
  endDate     DateTime
  /** 出发城市 */
  fromCity    String?
  /** 目的地/住宿城市（用于匹配住宿标准） */
  city        String?
  customerId  String?
  description String?
  createdAt   DateTime @default(now())

  claim    ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id])

  @@index([claimId, sortOrder])
}

/** 城市线级：用于差旅住宿标准 */
enum ExpenseCityTier {
  TIER_1
  TIER_2
  TIER_3
}

/** 差旅住宿标准（元/晚），系统配置单例 */
model ExpenseTravelPolicy {
  id            String   @id @default("default")
  hotelCapTier1 Decimal  @default(500)
  hotelCapTier2 Decimal  @default(400)
  hotelCapTier3 Decimal  @default(300)
  updatedAt     DateTime @updatedAt
  updatedById   String?

  updatedBy User? @relation("ExpenseTravelPolicyUpdater", fields: [updatedById], references: [id])
}

/** 城市 → 线级映射；未收录城市按三线及以下处理 */
model ExpenseCityTierMapping {
  id        String          @id @default(cuid())
  cityName  String          @unique
  tier      ExpenseCityTier
  enabled   Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tier, enabled, sortOrder])
}

model ExpenseInvoice {
  id                 String             @id @default(cuid())
  claimId            String
  fileName           String
  mimeType           String
  sizeBytes          Int
  storageKey         String
  /** 费用类别建议键，如 customer_visit / project_site / admin_office */
  categoryKey        String?
  amount             Decimal?
  taxRatePercent     Decimal?
  invoiceNo          String?
  invoicedAt         DateTime?
  sellerName         String?
  ocrNotes           String?
  ocrConfidence      String?
  ocrRawSummary      String?
  costTarget         ExpenseCostTarget?
  salesCostType      SalesCostType?
  customerId         String?
  presalesUserId     String?
  projectId          String?
  costCategory       String?
  postedSalesCostId  String?            @unique
  postedProjectCostId String?           @unique
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  claim            ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  customer         Customer?    @relation(fields: [customerId], references: [id])
  presalesUser     User?        @relation("ExpenseInvoicePresales", fields: [presalesUserId], references: [id])
  project          Project?     @relation(fields: [projectId], references: [id])
  postedSalesCost  SalesCost?   @relation("ExpenseInvoicePostedSalesCost", fields: [postedSalesCostId], references: [id])
  postedProjectCost ProjectCost? @relation("ExpenseInvoicePostedProjectCost", fields: [postedProjectCostId], references: [id])

  @@index([claimId, sortOrder])
}

model ExpenseApproval {
  id         String                @id @default(cuid())
  claimId    String
  step       ExpenseApprovalStep
  action     ExpenseApprovalAction
  actorId    String
  comment    String?
  createdAt  DateTime              @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor User         @relation("ExpenseApprovalActor", fields: [actorId], references: [id])

  @@index([claimId, createdAt])
  @@index([actorId, createdAt])
}

model ExpensePayout {
  id           String   @id @default(cuid())
  claimId      String   @unique
  amount       Decimal
  paidAt       DateTime
  notes        String?
  recordedById String
  createdAt    DateTime @default(now())

  claim      ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  recordedBy User         @relation("ExpensePayoutRecorder", fields: [recordedById], references: [id])
}
